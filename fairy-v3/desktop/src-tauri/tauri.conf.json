{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairy",
  "version": "0.1.0",
  "identifier": "com.fairy.desktop.v3",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fairy",
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 680,
        "resizable": true
      },
      {
        "label": "pet",
        "title": "Fairy Presence",
        "url": "index.html?surface=presence",
        "width": 196,
        "height": 240,
        "minWidth": 196,
        "minHeight": 240,
        "maxWidth": 196,
        "maxHeight": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Fairy Settings",
        "url": "index.html?surface=settings",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      },
      {
        "label": "guide",
        "title": "Fairy Guide",
        "url": "index.html?surface=guide",
        "width": 360,
        "height": 66,
        "minWidth": 360,
        "minHeight": 66,
        "maxWidth": 360,
        "maxHeight": 66,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "focusable": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/fairy-core"],
    "resources": {
      "runtime/git": "runtime/git",
      "runtime/voice-worker": "runtime/voice-worker",
      "../../voice-worker/assets": "runtime/voice-assets"
    },
    "targets": "all"
  }
}
