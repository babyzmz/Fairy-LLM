{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairy",
  "version": "0.2.0",
  "identifier": "com.fairy.desktop.v3",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fairy",
        "create": true,
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 680,
        "resizable": true
      },
      {
        "label": "companion",
        "title": "Fairy Realtime Companion Beta",
        "create": false,
        "url": "index.html?surface=companion",
        "width": 620,
        "height": 760,
        "minWidth": 520,
        "minHeight": 620,
        "resizable": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; media-src 'self' http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/fairy-core"],
    "resources": {
      "runtime/git": "runtime/git",
      "runtime/voice-worker": "runtime/voice-worker",
      "runtime/omni": "runtime/omni",
      "resources/omni": "runtime/omni-manifests",
      "resources/legal": "legal/licenses",
      "../../THIRD_PARTY_NOTICES.md": "legal/THIRD_PARTY_NOTICES.md",
      "../../docs/release": "docs/release",
      "../../voice-worker/assets": "runtime/voice-assets"
    },
    "targets": ["msi"],
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "ec229d26-4398-54b4-b566-22e1e656880b",
        "template": "wix/main.wxs"
      }
    }
  }
}
