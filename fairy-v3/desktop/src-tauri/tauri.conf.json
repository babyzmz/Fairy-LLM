{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fairy",
  "version": "0.2.0",
  "identifier": "com.fairy.desktop.v3",
  "build": {
    "beforeBuildCommand": "npm run build:desktop",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1430",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fairy",
        "create": true,
        "width": 1440,
        "height": 900,
        "minWidth": 880,
        "minHeight": 680,
        "resizable": true
      },
      {
        "label": "pet-render",
        "title": "Fairy Presence Renderer",
        "create": true,
        "url": "index.html?surface=pet-render",
        "x": -32000,
        "y": -32000,
        "width": 640,
        "height": 260,
        "minWidth": 640,
        "minHeight": 260,
        "maxWidth": 640,
        "maxHeight": 260,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      },
      {
        "label": "pet-input",
        "title": "Fairy Presence Input",
        "create": true,
        "url": "index.html?surface=pet-input",
        "x": -32000,
        "y": -32000,
        "width": 144,
        "height": 144,
        "minWidth": 144,
        "minHeight": 144,
        "maxWidth": 616,
        "maxHeight": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "focus": false,
        "visible": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Fairy Settings",
        "create": false,
        "url": "index.html?surface=settings",
        "width": 980,
        "height": 720,
        "minWidth": 760,
        "minHeight": 560,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost http://127.0.0.1:* data: blob:; media-src 'self' http://127.0.0.1:* blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.ico"],
    "externalBin": ["binaries/fairy-core"],
    "resources": {
      "runtime/git": "runtime/git",
      "runtime/voice-worker": "runtime/voice-worker",
      "../../voice-worker/assets": "runtime/voice-assets"
    },
    "targets": ["msi"],
    "windows": {
      "allowDowngrades": false,
      "wix": {
        "upgradeCode": "ec229d26-4398-54b4-b566-22e1e656880b",
        "template": "wix/main.wxs"
      }
    }
  }
}
