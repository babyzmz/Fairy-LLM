{
  "name": "fairy-v3-desktop",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1430",
    "build": "tsc --noEmit && vite build",
    "build:core-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-core-sidecar.ps1",
    "build:voice-sidecar": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/build-voice-sidecar.ps1",
    "build:git-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-git-runtime.ps1",
    "build:desktop": "npm run build:core-sidecar && npm run build:voice-sidecar && npm run build:git-runtime && npm run build",
    "e2e:serve": "npm run build && npm run preview:e2e",
    "generate:contracts": "npm --prefix ../tools/contracts run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --grep-invert @performance && playwright test --grep @performance --workers=1",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 1431",
    "presence:platform": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/check-presence-platform.ps1",
    "presence:native-build": "tauri build --no-bundle --config tauri.presence-build.conf.json",
    "tauri": "tauri",
    "release:windows": "tauri build && powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/collect-wix-media.ps1"
  },
  "dependencies": {
    "@tanstack/react-query": "5.101.2",
    "@tanstack/react-router": "1.170.17",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.24.0",
    "motion": "12.42.2",
    "pdfjs-dist": "5.4.624",
    "react": "19.2.7",
    "react-aria-components": "1.19.0",
    "react-dom": "19.2.7",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "three": "0.185.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@playwright/test": "1.61.1",
    "@rolldown/plugin-babel": "0.2.3",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/babel__core": "7.20.5",
    "@types/node": "26.1.1",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.1",
    "@vitejs/plugin-react": "6.0.3",
    "babel-plugin-react-compiler": "1.0.0",
    "jsdom": "29.1.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
